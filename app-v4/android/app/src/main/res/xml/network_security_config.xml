<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only system certificate authorities: a user-installed CA (a common interception
     setup) is not trusted. Certificate pinning is not used because the host's certificates rotate. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
