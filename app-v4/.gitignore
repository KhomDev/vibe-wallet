# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local scratch from research
/agent-tools/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android / signing (never commit the keystore or build outputs)
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/captures/
/cap-www
*.jks
*.keystore
*.apk
# APK is copied into public/download just before deploy
!/public/download/.gitkeep

playwright-report/
test-results/
