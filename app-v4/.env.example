# Optional. When unset, the app uses the deterministic local intent parser
# and labels that fallback in the UI. The same server-only key is used for
# voice transcription via NEAR AI Whisper. Never prefix this with NEXT_PUBLIC_.
NEAR_AI_API_KEY=

# Optional overrides. The defaults are the public NEAR AI Cloud gateway.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_STT_MODEL=openai/whisper-large-v3

# Optional. Network: testnet (default) or mainnet. Mainnet swaps execute via
# lib/server/intents-swap.ts; the in-app swap card stays quote-only on testnet.
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Optional. Public RPC used by the browser. Not a secret.
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# Optional. NEAR Intents 1Click API. Quotes are forced to dry:true.
INTENTS_API_URL=https://1click.chaindefuser.com/v0

# Shared demo account (server-only, never NEXT_PUBLIC_)
DEMO_NEAR_ACCOUNT_ID=
DEMO_NEAR_PRIVATE_KEY=
DEMO_NEAR_PUBLIC_KEY=
DEMO_RECIPIENT_ACCOUNT_ID=
AGENT_CRON_SECRET=
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=
AGENT_STATE_BLOB_URL=
AGENT_STATE_PATH=
