# Names only. Never commit values. Every variable below is read on the server unless it starts with
# NEXT_PUBLIC_, which is public by definition and must never hold a secret.

# Optional. When unset, the app uses the deterministic local intent parser and labels that
# fallback in the UI. The same server-only key is used for voice transcription via NEAR AI
# Whisper. Set a spending limit on the key in NEAR AI Cloud: it is the final bound on model cost.
NEAR_AI_API_KEY=

# Optional overrides. The defaults are the public NEAR AI Cloud gateway.
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
NEAR_AI_MODEL=z-ai/glm-5.3-flash
NEAR_AI_STT_MODEL=openai/whisper-large-v3

# Optional. Network: testnet (default) or mainnet. The shared demo signer refuses to sign unless
# this is testnet AND the RPC node reports chain_id "testnet".
NEXT_PUBLIC_NEAR_NETWORK=testnet

# Optional. Public RPC used by the browser. Not a secret.
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# Optional. NEAR Intents 1Click API. In-app quotes are forced to dry:true.
INTENTS_API_URL=https://1click.chaindefuser.com/v0

# Shared demo account (server-only, testnet only).
DEMO_NEAR_ACCOUNT_ID=
DEMO_NEAR_PRIVATE_KEY=
DEMO_NEAR_PUBLIC_KEY=
DEMO_RECIPIENT_ACCOUNT_ID=

# Bearer secret for Vercel Cron and for the operator-only global kill switch. Use a long random value.
CRON_SECRET=
# Optional alias for CRON_SECRET.
AGENT_CRON_SECRET=
# Optional. HMAC key for visitor cookies and confirmation tokens. Defaults to a hash of CRON_SECRET.
DEMO_VISITOR_SECRET=

# Required on Vercel for demo sends: the durable, compare-and-swap state store (private Blob).
BLOB_READ_WRITE_TOKEN=
# Local development only: file used instead of Blob when no Blob token is set.
AGENT_STATE_PATH=
# Optional. "off" disables the daily NEAR Social mirror written by the cron route.
AGENT_SOCIAL_MIRROR=

# Optional demo limit overrides (defaults in lib/server/demo-limits.ts).
DEMO_SENDS_PER_HOUR=
DEMO_SENDS_PER_DAY=
DEMO_NETWORK_SENDS_PER_HOUR=
DEMO_NETWORK_SENDS_PER_DAY=
DEMO_NETWORK_DAILY_NEAR=
DEMO_GLOBAL_SENDS_PER_HOUR=
DEMO_GLOBAL_DAILY_NEAR=
DEMO_VISITOR_MINTS_PER_DAY=
